# API Architect Backend Configuration
# Copy this file to .env and update values as needed

# Application
APP_NAME=api-architect
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json
