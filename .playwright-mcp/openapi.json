{
  "openapi": "3.1.0",
  "info": {
    "title": "PetStore",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "description": "List all pets.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "description": "Create a new pet.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "description": "Get a pet by ID.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "description": "A pet in the store.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier",
            "examples": [
              1
            ]
          },
          "name": {
            "type": "string",
            "description": "Pet's name",
            "examples": [
              "John Doe"
            ]
          },
          "status": {
            "type": "string",
            "description": "Pet status (available, pending, sold)",
            "examples": [
              "active"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "examples": [
              1
            ]
          },
          "name": {
            "type": "string",
            "description": "Category name",
            "examples": [
              "John Doe"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    }
  }
}